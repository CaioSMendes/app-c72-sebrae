<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <!-- ========================================================= -->
    <!-- ÁREA PRINCIPAL -->
    <!-- ========================================================= -->

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ===================================================== -->
        <!-- CABEÇALHO + INFORMAÇÕES + BOTÕES -->
        <!-- TUDO AQUI SOBE/DESCE COM A LISTA -->
        <!-- ===================================================== -->

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLivre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FAFAFA"
            android:elevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_scrollFlags="scroll|enterAlways">

                <!-- ================================================= -->
                <!-- HEADER -->
                <!-- ================================================= -->

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="#005eb8"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:id="@+id/logoSEBRAE"
                        android:layout_width="65dp"
                        android:layout_height="65dp"
                        android:layout_centerVertical="true"
                        android:layout_alignParentStart="true"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_sebrae_branco" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Leitura Livre"
                        android:textColor="@android:color/white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="12dp"
                        android:layout_toEndOf="@id/logoSEBRAE" />

                </RelativeLayout>


                <!-- ================================================= -->
                <!-- INFORMAÇÕES -->
                <!-- ================================================= -->

                <TextView
                    android:id="@+id/txtInfoTopo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/white"
                    android:text="Informacoes"
                    android:textStyle="bold"
                    android:textColor="#005eb8"
                    android:textSize="15sp"
                    android:paddingTop="8dp"
                    android:paddingBottom="2dp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/txtInfoUser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/white"
                    android:text="Usuario"
                    android:textStyle="bold"
                    android:textColor="#005eb8"
                    android:textSize="13sp"
                    android:paddingTop="2dp"
                    android:paddingBottom="8dp"
                    android:gravity="center" />


                <!-- ================================================= -->
                <!-- BOTÕES SUPERIORES -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@android:color/white"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="6dp">

                    <!-- LER TAGS -->

                    <LinearLayout
                        android:id="@+id/btnLerTags"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:background="@drawable/btn_rounded"
                        android:backgroundTint="#005eb8"
                        android:layout_marginEnd="3dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ler_rfid"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/txtTituloBotao"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Ler Tags"
                            android:textColor="@android:color/white"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:maxLines="2"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp" />

                    </LinearLayout>


                    <!-- LIMPAR TAGS -->

                    <LinearLayout
                        android:id="@+id/btnLimparTags"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:background="@drawable/btn_rounded"
                        android:backgroundTint="#F57F17"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_clean"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Limpar Tags"
                            android:textColor="@android:color/white"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:maxLines="2"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp" />

                    </LinearLayout>


                    <!-- MODO -->

                    <LinearLayout
                        android:id="@+id/btnModoToggleLivre"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:background="@drawable/btn_rounded"
                        android:backgroundTint="#005eb8"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_leitorrfid"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/txtModoToggleLivre"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Modo: RFID"
                            android:textColor="@android:color/white"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:maxLines="2"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp" />

                    </LinearLayout>


                    <!-- DISTÂNCIA -->

                    <LinearLayout
                        android:id="@+id/btnDistancia"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:background="@drawable/btn_rounded"
                        android:backgroundTint="#546E7A"
                        android:layout_marginStart="3dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/distance"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Distância"
                            android:textColor="@android:color/white"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:maxLines="2"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp" />

                    </LinearLayout>

                </LinearLayout>


                <!-- ================================================= -->
                <!-- CONTADOR -->
                <!-- ================================================= -->

                <TextView
                    android:id="@+id/tvTagCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/white"
                    android:text="Tags lidas: 0"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="6dp" />

            </LinearLayout>

        </com.google.android.material.appbar.AppBarLayout>


        <!-- ===================================================== -->
        <!-- ÁREA DE CONTEÚDO ROLÁVEL -->
        <!-- ===================================================== -->

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/white"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <!-- ================================================= -->
            <!-- LISTA DE TAGS -->
            <!-- ================================================= -->

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:overScrollMode="never">

                <LinearLayout
                    android:id="@+id/containerTags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@android:color/white"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="80dp" />

            </ScrollView>

        </FrameLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>


    <!-- ========================================================= -->
    <!-- RODAPÉ FIXO -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="#FAFAFA"
        android:elevation="8dp">


        <!-- RESUMO -->

        <LinearLayout
            android:id="@+id/btnResumo"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/btn_rounded"
            android:backgroundTint="#005eb8"
            android:layout_marginEnd="3dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_resumo"
                android:layout_marginBottom="3dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Resumo"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center" />

        </LinearLayout>


        <!-- CONCLUIR -->

        <LinearLayout
            android:id="@+id/btnConcluir"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/btn_rounded"
            android:backgroundTint="#4CAF50"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_concluir"
                android:layout_marginBottom="3dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Concluir"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center" />

        </LinearLayout>


        <!-- HISTÓRICO -->

        <LinearLayout
            android:id="@+id/btnHistorico"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/btn_rounded"
            android:backgroundTint="#546E7A"
            android:layout_marginStart="3dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_historico"
                android:layout_marginBottom="3dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Histórico"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>