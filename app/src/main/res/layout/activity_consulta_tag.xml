<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <!-- HEADER — fixo no topo -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#005eb8"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/logoSEBRAE"
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_sebrae_branco" />

        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Informações Inventário"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/logoSEBRAE" />
    </RelativeLayout>

    <!-- ÁREA SCROLLÁVEL -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- INFO DO TOPO -->
            <TextView
                android:id="@+id/txtInfoTopo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Informacoes"
                android:textStyle="bold"
                android:textColor="#005eb8"
                android:textSize="16sp"
                android:padding="12dp"
                android:gravity="center" />

            <TextView
                android:id="@+id/txtInfoUser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Usuario"
                android:textStyle="bold"
                android:textColor="#005eb8"
                android:textSize="16sp"
                android:padding="12dp"
                android:gravity="center" />

            <!-- BOTÕES SUPERIORES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:layout_marginBottom="6dp"
                android:layout_marginTop="4dp">

                <!-- LER TAGS -->
                <LinearLayout
                    android:id="@+id/btnLerTags"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/btn_rounded"
                    android:backgroundTint="#005eb8"
                    android:layout_marginEnd="3dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ler_rfid"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/txtTituloBotao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ler Tags"
                        android:textColor="@android:color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:maxLines="2"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp" />
                </LinearLayout>

                <!-- LIMPAR -->
                <LinearLayout
                    android:id="@+id/btnLimparTags"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/btn_rounded"
                    android:backgroundTint="#F57F17"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_clean"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Limpar Tags"
                        android:textColor="@android:color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:maxLines="2"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp" />
                </LinearLayout>

                <!-- DISTÂNCIA -->
                <LinearLayout
                    android:id="@+id/btnDistancia"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/btn_rounded"
                    android:backgroundTint="#546E7A"
                    android:layout_marginStart="3dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/distance"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Distância"
                        android:textColor="@android:color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:maxLines="2"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp" />
                </LinearLayout>

            </LinearLayout>

            <!-- CONTADOR -->
            <TextView
                android:id="@+id/tvTagCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tags lidas: 0"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:paddingStart="8dp"
                android:layout_marginBottom="6dp" />

            <!-- BOTÕES RFID / COD. BARRA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:layout_marginBottom="6dp">

                <LinearLayout
                    android:id="@+id/btnRfid"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/btn_rounded"
                    android:backgroundTint="#005eb8"
                    android:layout_marginEnd="3dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_leitorrfid"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/txtRfid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="RFID"
                        android:textColor="@android:color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:maxLines="2"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnCodBar"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/btn_rounded"
                    android:backgroundTint="#4CAF50"
                    android:layout_marginStart="3dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_codbarra"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/txtCodBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cód. Barra"
                        android:textColor="@android:color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:maxLines="2"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp" />
                </LinearLayout>

            </LinearLayout>

            <!-- RADIO AUTO / SINGLE -->
            <RadioGroup
                android:id="@+id/rgMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:layout_marginBottom="8dp">

                <RadioButton
                    android:id="@+id/rbLoop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Auto" />

                <RadioButton
                    android:id="@+id/rbSingle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Single"
                    android:layout_marginStart="24dp" />
            </RadioGroup>

            <!-- LISTA — RecyclerView sem scroll próprio -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listViewTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/white"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- Espaço pra barra inferior não cobrir o último item -->
            <View
                android:layout_width="match_parent"
                android:layout_height="80dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BOTÕES INFERIORES — fixos no rodapé -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="#FAFAFA">

        <LinearLayout
            android:id="@+id/btnResumo"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/btn_rounded"
            android:backgroundTint="#005eb8"
            android:layout_marginEnd="3dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_resumo"
                android:layout_marginBottom="3dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Resumo"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnConcluir"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/btn_rounded"
            android:backgroundTint="#4CAF50"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_concluir"
                android:layout_marginBottom="3dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Concluir"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnHistorico"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/btn_rounded"
            android:backgroundTint="#546E7A"
            android:layout_marginStart="3dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_historico"
                android:layout_marginBottom="3dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Histórico"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>