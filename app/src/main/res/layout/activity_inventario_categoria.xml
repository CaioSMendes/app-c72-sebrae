<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarCategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FAFAFA"
            android:elevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_scrollFlags="scroll|enterAlways">

                <!-- HEADER -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="#005eb8"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:id="@+id/logoSEBRAE"
                        android:layout_width="65dp"
                        android:layout_height="65dp"
                        android:layout_centerVertical="true"
                        android:layout_alignParentStart="true"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_sebrae_branco" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Leitura por Categoria"
                        android:textColor="@android:color/white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="12dp"
                        android:layout_toEndOf="@id/logoSEBRAE" />
                </RelativeLayout>

                <!-- INFO -->
                <TextView
                    android:id="@+id/txtInfoTopoCategoria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/white"
                    android:text="Informacoes"
                    android:textStyle="bold"
                    android:textColor="#005eb8"
                    android:textSize="15sp"
                    android:paddingTop="8dp"
                    android:paddingBottom="2dp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/txtInfoUserCategoria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/white"
                    android:text="Usuario"
                    android:textStyle="bold"
                    android:textColor="#005eb8"
                    android:textSize="13sp"
                    android:paddingTop="2dp"
                    android:paddingBottom="8dp"
                    android:gravity="center" />

                <!-- BOTÕES SUPERIORES -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@android:color/white"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="6dp">

                    <LinearLayout
                        android:id="@+id/btnLerCategoria"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:background="@drawable/btn_rounded"
                        android:backgroundTint="#005eb8"
                        android:layout_marginEnd="3dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ler_rfid"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/txtBotaoCategoria"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Iniciar Leitura"
                            android:textColor="@android:color/white"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:maxLines="2"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnLimparCategoria"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/btn_rounded"
                        android:backgroundTint="#F57F17"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_clean"
                            android:layout_marginBottom="3dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Limpar"
                            android:textColor="@android:color/white"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:gravity="center" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnModoToggleCategoria"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:background="@drawable/btn_rounded"
                        android:backgroundTint="#005eb8"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_leitorrfid"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/txtModoToggleCategoria"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Modo: RFID"
                            android:textColor="@android:color/white"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:maxLines="2"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnDistanciaCategoria"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:background="@drawable/btn_rounded"
                        android:backgroundTint="#546E7A"
                        android:layout_marginStart="3dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/distance"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Distância"
                            android:textColor="@android:color/white"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:maxLines="2"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- FILTRO DE CATEGORIA PARA LEITURA (o que o leitor aceita) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@android:color/white"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="6dp">

                    <LinearLayout
                        android:id="@+id/btnFiltrarCategoriasCategoria"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/btn_rounded"
                        android:backgroundTint="#546E7A"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@android:drawable/ic_menu_sort_by_size"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/txtBotaoFiltroCategoria"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Selecionar categorias (obrigatório)"
                            android:textColor="@android:color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▾"
                            android:textColor="@android:color/white"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:id="@+id/scrollChipsFiltroCategoria"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:visibility="gone"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/llChipsFiltroCategoria"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- CONTADOR + BUSCA -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@android:color/white"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:id="@+id/tvContadorCategoria"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Lidos: 0 / 0"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:paddingBottom="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_btn_card"
                        android:visibility="gone" >

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_search"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="6dp"
                            android:alpha="0.5" />

                        <EditText
                            android:id="@+id/etBuscaCategoria"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:hint="Buscar categoria (ex: notebook, cadeira...)"
                            android:textSize="13sp"
                            android:background="@null"
                            android:inputType="text"
                            android:imeOptions="actionSearch"
                            android:singleLine="true" />

                        <TextView
                            android:id="@+id/btnLimparFiltro"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:text="✕"
                            android:textSize="16sp"
                            android:textColor="#999999"
                            android:gravity="center"
                            android:visibility="gone"
                            android:clickable="true"
                            android:focusable="true"
                            android:layout_marginEnd="4dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- FILTROS COM CONTADORES -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@android:color/white"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:id="@+id/btnFiltroTodos"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="3dp"
                        android:background="@drawable/btn_rounded"
                        android:backgroundTint="#005eb8"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Todos"
                            android:textColor="@android:color/white"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtQtdTodos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="0"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnFiltroPendentes"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:background="@drawable/btn_rounded"
                        android:backgroundTint="#B0BEC5"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pendentes"
                            android:textColor="@android:color/white"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtQtdPendentes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="0"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnFiltroEncontrados"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:background="@drawable/btn_rounded"
                        android:backgroundTint="#B0BEC5"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Encontrados"
                            android:textColor="@android:color/white"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtQtdEncontrados"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="0"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnFiltroDivergentes"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/btn_rounded"
                        android:backgroundTint="#B0BEC5"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Fora do local"
                            android:textColor="@android:color/white"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtQtdDivergentes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="0"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- LISTA: rola normalmente e "empurra" o AppBar pra cima/baixo -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/white"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategorias"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="8dp"
                android:scrollbars="vertical" />

            <TextView
                android:id="@+id/tvEmptyStateCategoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|top"
                android:layout_marginTop="48dp"
                android:text="Nenhum patrimônio cadastrado neste local."
                android:textSize="14sp"
                android:textColor="#9E9E9E"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone" />
        </FrameLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- BOTÕES INFERIORES — sempre fixos, fora do CoordinatorLayout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="#FAFAFA"
        android:elevation="8dp">

        <LinearLayout
            android:id="@+id/btnResumoCategoria"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/btn_rounded"
            android:backgroundTint="#005eb8"
            android:layout_marginEnd="3dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_resumo"
                android:layout_marginBottom="3dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Resumo"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnConcluirCategoria"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/btn_rounded"
            android:backgroundTint="#4CAF50"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_concluir"
                android:layout_marginBottom="3dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Concluir"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnHistoricoCategoria"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/btn_rounded"
            android:backgroundTint="#546E7A"
            android:layout_marginStart="3dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_historico"
                android:layout_marginBottom="3dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Histórico"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
