<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <!-- Barra de título -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#005eb8"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/logoSEBRAE"
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_sebrae_branco" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Leitura por Local"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/logoSEBRAE" />
    </RelativeLayout>

    <!-- INFO DO TOPO -->
    <TextView
        android:id="@+id/txtInfoTopoLocal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Informacoes"
        android:textStyle="bold"
        android:textColor="#005eb8"
        android:textSize="16sp"
        android:padding="12dp"
        android:gravity="center" />

    <TextView
        android:id="@+id/txtInfoUserLocal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Usuario"
        android:textStyle="bold"
        android:textColor="#005eb8"
        android:textSize="16sp"
        android:padding="12dp"
        android:gravity="center" />

    <!-- ═══ BOTÕES SUPERIORES — vertical, altura fixa 72dp ════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:layout_marginBottom="6dp"
        android:layout_marginTop="4dp">

        <!-- INICIAR / PARAR LEITURA -->
        <LinearLayout
            android:id="@+id/btnLerLocal"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:orientation="vertical"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/btn_rounded"
            android:backgroundTint="#005eb8"
            android:layout_marginEnd="3dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ler_rfid"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/txtBotaoLocal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Iniciar Leitura"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="2"
                android:paddingStart="2dp"
                android:paddingEnd="2dp" />
        </LinearLayout>

        <!-- LIMPAR -->
        <LinearLayout
            android:id="@+id/btnLimparLocal"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/btn_rounded"
            android:backgroundTint="#F57F17"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_clean"
                android:layout_marginBottom="3dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Limpar"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center" />
        </LinearLayout>

        <!-- TOGGLE MODO RFID / CÓD. BARRAS -->
        <LinearLayout
            android:id="@+id/btnModoToggleLocal"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:orientation="vertical"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/btn_rounded"
            android:backgroundTint="#005eb8"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_leitorrfid"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/txtModoToggleLocal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Modo: RFID"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="2"
                android:paddingStart="2dp"
                android:paddingEnd="2dp" />
        </LinearLayout>

        <!-- DISTÂNCIA -->
        <LinearLayout
            android:id="@+id/btnDistanciaLocal"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:orientation="vertical"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/btn_rounded"
            android:backgroundTint="#546E7A"
            android:layout_marginStart="3dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/distance"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Distância"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="2"
                android:paddingStart="2dp"
                android:paddingEnd="2dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Contador + busca -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvContadorLocal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Lidos: 0 / 0"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#333333" />

        <EditText
            android:id="@+id/etBuscaLocal"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="2"
            android:hint="Buscar patrimônio..."
            android:textSize="13sp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/bg_btn_card"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:singleLine="true" />
    </LinearLayout>

    <!-- ═══ LISTA — scroll livre, ocupa espaço restante ══════ -->
    <ListView
        android:id="@+id/listViewLocal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/darker_gray"
        android:dividerHeight="1dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:clipToPadding="false"
        android:scrollbarStyle="outsideOverlay"
        android:background="@android:color/white"
        android:nestedScrollingEnabled="true" />

    <!-- ═══ BOTÕES INFERIORES — vertical, altura fixa 64dp ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="#FAFAFA">

        <!-- RESUMO -->
        <LinearLayout
            android:id="@+id/btnResumoLocal"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/btn_rounded"
            android:backgroundTint="#005eb8"
            android:layout_marginEnd="3dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_resumo"
                android:layout_marginBottom="3dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Resumo"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center" />
        </LinearLayout>

        <!-- CONCLUIR -->
        <LinearLayout
            android:id="@+id/btnConcluirLocal"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/btn_rounded"
            android:backgroundTint="#4CAF50"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_concluir"
                android:layout_marginBottom="3dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Concluir"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center" />
        </LinearLayout>

        <!-- HISTÓRICO -->
        <LinearLayout
            android:id="@+id/btnHistoricoLocal"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/btn_rounded"
            android:backgroundTint="#546E7A"
            android:layout_marginStart="3dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_historico"
                android:layout_marginBottom="3dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Histórico"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>