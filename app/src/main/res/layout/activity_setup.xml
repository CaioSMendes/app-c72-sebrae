<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFAFA">

    <!-- Barra de título -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#005eb8">

        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configurações"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:drawableStart="@drawable/ic_config"
            android:drawablePadding="8dp" />

        <ImageView
            android:id="@+id/imgEngrenagem"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:tint="@android:color/white"/>

    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── Card: Ambiente ── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Label do grupo -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ambiente"
                        android:textSize="13sp"
                        android:textColor="#005eb8"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <!-- RadioGroup -->
                    <RadioGroup
                        android:id="@+id/rgAmbiente"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rbHomologacao"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Homologação"
                            android:textColor="#333333"
                            android:buttonTint="#005eb8"
                            android:checked="true"/>

                        <RadioButton
                            android:id="@+id/rbProducao"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Produção"
                            android:textColor="#333333"
                            android:buttonTint="#005eb8"/>

                    </RadioGroup>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── Card: Base URL ── -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardBaseUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:visibility="gone"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Base URL"
                        android:textSize="13sp"
                        android:textColor="#ff6400"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <!-- Row: ícone + campo -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_url"
                            android:layout_marginEnd="12dp"/>

                        <EditText
                            android:id="@+id/edtBaseUrl"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Base URL"
                            android:inputType="textUri"
                            android:background="@android:color/transparent"
                            android:textSize="14sp"
                            android:textColor="#333333"
                            android:textColorHint="#AAAAAA"/>

                    </LinearLayout>

                    <!-- Dica de campo bloqueado -->
                    <TextView
                        android:id="@+id/txtUrlInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="URL preenchida automaticamente para Homologação."
                        android:textSize="11sp"
                        android:textColor="#888888"
                        android:layout_marginTop="6dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Botão salvar -->
            <Button
                android:id="@+id/btnSalvar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_rounded"
                android:text="Salvar"
                android:backgroundTint="#005eb8"
                android:textColor="@android:color/white"
                android:padding="14dp"
                android:textAllCaps="false"
                android:layout_marginBottom="16dp"/>

            <!-- Resumo dos dados salvos -->
            <TextView
                android:id="@+id/txtDadosSalvos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nenhum dado salvo ainda"
                android:textSize="14sp"
                android:textColor="#555555"
                android:lineSpacingExtra="4dp"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>