<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground">

    <!-- Imagem fixa -->
    <ImageView
        android:id="@+id/imgLocal"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_locais"
        android:contentDescription="Imagem do Local"
        android:scaleType="centerCrop"
        android:layout_marginEnd="12dp" />

    <!-- Dados do Local -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_weight="1">

        <!-- Código em cima, menor e cinza -->
        <TextView
            android:id="@+id/txtCodigoLocal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Código Local"
            android:textSize="12sp"
            android:textColor="#888888"
            android:textAllCaps="true"
            android:letterSpacing="0.05" />

        <!-- Nome embaixo, em negrito -->
        <TextView
            android:id="@+id/txtLocalNome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Local Nome"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#222222"
            android:layout_marginTop="2dp" />

    </LinearLayout>
</LinearLayout>